<UserControl x:Class="FalconBMS.Launcher.Views.ControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1248"
             d:DesignHeight="680">

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}"
          Style="{StaticResource ViewContentRootStyle}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Profile and Last Input -->
        <Grid Grid.Row="0"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="12,8">

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Profile"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ComboBox Width="180"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  DisplayMemberPath="AircraftProfile"/>

                        <Button Content="Import Controls"
                                Width="130"
                                Command="{Binding ImportBindingsCommand}"
                                Margin="24,0,8,0"/>

                        <Button Content="Export Controls"
                                Width="130"
                                Command="{Binding ExportBindingsCommand}"/>

                    </StackPanel>

                    <TextBlock Text="{Binding HelperText}"
                               Style="{StaticResource MutedTextBlockStyle}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>

                </StackPanel>
            </Border>

            <!-- Last Input -->
            <Border Grid.Column="2"
                    Style="{StaticResource DashboardCardStyle}"
                    Padding="12,8">

                <Grid VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Last Input"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="LastInputDeviceText"
                               Grid.Row="0"
                               Grid.Column="1"
                               Text="No input detected"
                               Style="{StaticResource MutedTextBlockStyle}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                    <TextBlock x:Name="LastInputValueText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Text="—"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               FontSize="{StaticResource FontSizeMedium}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="200"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                </Grid>
            </Border>
        </Grid>

        <!-- Filters and Mapping Table -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12,6,12,12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{DynamicResource AppSurfaceBrush}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">

                        <TextBlock Text="{Binding ResultsCountText}"
                                   Style="{StaticResource ControlsSidebarResultHeaderTextBlockStyle}"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="FILTER BY TEXT"
                                   Style="{StaticResource ControlsNavHeadingTextBlockStyle}"/>

                        <Grid Margin="0,0,0,20">

                            <TextBox x:Name="FilterTextBox"
                                     Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource AppFontFamily}"
                                     FontSize="{StaticResource FontSizeSmall}"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>

                            <TextBlock Text="Type to filter..."
                                       Style="{StaticResource ControlsFilterPlaceholderTextBlockStyle}"
                                       Margin="9,0,0,0"/>

                        </Grid>

                        <TextBlock Text="FILTER BY CATEGORY"
                                   Style="{StaticResource ControlsNavHeadingTextBlockStyle}"/>

                    </StackPanel>

                    <ListBox x:Name="CategoryListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ControlsNavListBoxStyle}"
                             ItemContainerStyle="{StaticResource ControlsNavListBoxItemStyle}"
                             PreviewKeyDown="CategoryListBox_PreviewKeyDown"
                             PreviewMouseLeftButtonUp="CategoryListBox_PreviewMouseLeftButtonUp"/>

                    <Button Grid.Row="2"
                            Content="{Binding ClearFilterButtonText}"
                            Command="{Binding ClearFilterCommand}"
                            Width="120"
                            Height="32"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"/>

                </Grid>
            </Border>

            <DataGrid x:Name="ControlsGrid"
                      Grid.Column="2"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Style="{StaticResource ControlsTableStyle}"
                      FrozenColumnCount="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="ControlsGrid_MouseDoubleClick"
                      ColumnReordered="ControlsGrid_ColumnReordered"
                      PreviewKeyDown="ControlsGrid_PreviewKeyDown">

                <DataGrid.Columns/>

            </DataGrid>

        </Grid>
    </Grid>
</UserControl>